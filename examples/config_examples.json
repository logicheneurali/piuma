{
  "panel": {
    "font": "Noto Sans",
    "font_size": 14,
    "section_layout": "horizontal",
    "section_title": true,
    "default_section_weight": 1,
    "default_bg_color": "#1a1b26",
    "default_text_color": "#e8e8e8",
    "sections": [
      {
        "name": "System",
        "layout": "horizontal",
        "weight": null,
        "bg_color": "#2d2d3a",
        "text_color": "#ff6b6b",
        "sensors": [
          {
            "name": "CPU",
            "description": "CPU usage percentage",
            "source": { "type": "ProcCpu" },
            "text_color": "#ffaa00",
            "bg_color": null
          },
          {
            "name": "GPU",
            "description": "NVIDIA GPU load",
            "source": { "type": "NvidiaGpu" },
            "text_color": null,
            "bg_color": null
          },
          {
            "name": "RAM",
            "description": "Memory usage (used/total MB)",
            "source": { "type": "ProcMem" },
            "text_color": null,
            "bg_color": null
          },
          {
            "name": "Disk",
            "description": "Disk usage (/ partition)",
            "source": { "type": "ProcDisk" },
            "text_color": null,
            "bg_color": null
          },
          {
            "name": "Uptime",
            "description": "System uptime",
            "source": { "type": "Uptime" },
            "text_color": null,
            "bg_color": null
          }
        ]
      },
      {
        "name": "Network",
        "layout": "horizontal",
        "weight": null,
        "bg_color": "#2a2a3e",
        "text_color": "#4ecdc4",
        "sensors": [
          {
            "name": "Ethernet",
            "description": "Ethernet connection",
            "source": { "type": "Network", "interface": "eth0" },
            "text_color": null,
            "bg_color": null
          },
          {
            "name": "WiFi",
            "description": "WiFi signal strength",
            "source": { "type": "Network", "interface": "wlan0" },
            "text_color": null,
            "bg_color": null
          }
        ]
      },
      {
        "name": "Audio",
        "layout": "horizontal",
        "weight": null,
        "bg_color": "#2a2a3e",
        "text_color": "#4ecdc4",
        "sensors": [
          {
            "name": "Volume",
            "description": "Audio volume level",
            "source": { "type": "Audio", "device": "default" },
            "text_color": null,
            "bg_color": null
          }
        ]
      },
      {
        "name": "Window",
        "layout": "horizontal",
        "weight": null,
        "bg_color": "#2a2a3e",
        "text_color": "#4ecdc4",
        "sensors": [
          {
            "name": "Focused",
            "description": "Current focused window title",
            "source": { "type": "Window" },
            "text_color": null,
            "bg_color": null
          }
        ]
      },
      {
        "name": "Clock",
        "layout": "horizontal",
        "weight": null,
        "bg_color": "#2a2a3e",
        "text_color": "#4ecdc4",
        "sensors": [
          {
            "name": "Time",
            "description": "Current time",
            "source": { "type": "Clock" },
            "text_color": null,
            "bg_color": null
          },
          {
            "name": "Date",
            "description": "Current date",
            "source": { "type": "Clock", "format": "date" },
            "text_color": null,
            "bg_color": null
          }
        ]
      }
    ]
  }
}